{
  "manifest_version": 3,
  "name": "HTML to Figma",
  "description": "Captura DOM + estilos computados e copia um JSON para colar no plugin do Figma.",
  "version": "0.4.0",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "HTML to Figma"
  }
}
